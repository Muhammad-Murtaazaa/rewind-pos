datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --------------------------------------------------------
// ENUMS
// --------------------------------------------------------

enum UserRole {
  OWNER
  MANAGER
  CASHIER
  WAITER
  BARISTA
  KITCHEN
  ACCOUNTANT
  CUSTOM
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  ONLINE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  COMPLETED
  VOIDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  JAZZCASH
  EASYPAISA
  BANK_TRANSFER
  QR_PAYMENT
  CUSTOMER_TAB
  GIFT_CARD
  SPLIT
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
  VOIDED
  FAILED
}

enum KdsStationType {
  BAR
  KITCHEN
  EXPO
}

enum TicketItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
}

enum StockMovementType {
  SALE_DEDUCTION
  PURCHASE_RECEIPT
  WASTAGE
  COUNT_ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  INITIAL_FLOAT
}

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  COGS
}

// --------------------------------------------------------
// MODULE 1: SETUP, TENANCY, USERS & ACCESS
// --------------------------------------------------------

model Tenant {
  id         String    @id @default(uuid())
  slug       String    @unique
  name       String
  logo_url   String?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  version    Int       @default(1)
  device_id  String?

  branches   Branch[]
  users      User[]
  settings   Setting[]
  accounts   Account[]
}

model Branch {
  id         String    @id @default(uuid())
  tenant_id  String
  name       String
  address    String?
  phone      String?
  tax_number String?   // FBR / PRA NTN/STRN
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  version    Int       @default(1)
  device_id  String?

  tenant     Tenant    @relation(fields: [tenant_id], references: [id])
  devices    Device[]
  orders     Order[]
  tables     Table[]
  floors     FloorArea[]
  stock_locs Location[]

  @@index([tenant_id])
}

model User {
  id             String         @id @default(uuid())
  tenant_id      String
  branch_id      String
  name           String
  email          String?        @unique
  password_hash  String?
  pin_hash       String         // Hashed 4-6 digit numeric PIN
  role           UserRole       @default(CASHIER)
  custom_role_id String?
  is_active      Boolean        @default(true)
  discount_limit Decimal        @default(10.00) @db.Decimal(5, 2)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  deleted_at     DateTime?
  version        Int            @default(1)
  device_id      String?

  tenant         Tenant         @relation(fields: [tenant_id], references: [id])
  custom_role    CustomRole?    @relation(fields: [custom_role_id], references: [id])
  staff_profile  StaffProfile?
  audit_logs     AuditLog[]
  orders_created Order[]        @relation("OrderCashier")
  shifts         Shift[]
  attendance     AttendanceEvent[]
  cash_sessions  CashSession[]

  @@index([tenant_id, branch_id])
  @@index([pin_hash])
}

model CustomRole {
  id          String    @id @default(uuid())
  tenant_id   String
  branch_id   String
  name        String
  permissions String[]
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  version     Int       @default(1)
  device_id   String?

  users       User[]
}

model Device {
  id               String    @id @default(uuid())
  tenant_id        String
  branch_id        String
  device_identifier String   @unique
  device_prefix    String    // e.g. "T1"
  name             String
  is_registered    Boolean   @default(true)
  last_sync_at     DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  deleted_at       DateTime?
  version          Int       @default(1)
  device_id        String?

  branch           Branch    @relation(fields: [branch_id], references: [id])
}

model Setting {
  id          String    @id @default(uuid())
  tenant_id   String
  branch_id   String
  key         String
  value       String
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  version     Int       @default(1)
  device_id   String?

  tenant      Tenant    @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, key])
}

model AuditLog {
  id          String    @id @default(uuid())
  tenant_id   String
  branch_id   String
  user_id     String?
  action      String
  entity_name String
  entity_id   String
  payload_old Json?
  payload_new Json?
  reason      String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  version     Int       @default(1)
  device_id   String?

  user        User?     @relation(fields: [user_id], references: [id])

  @@index([tenant_id, entity_name, entity_id])
}

// --------------------------------------------------------
// MODULE 2: MENU & CATALOG
// --------------------------------------------------------

model Category {
  id          String    @id @default(uuid())
  tenant_id   String
  branch_id   String
  name_en     String
  name_ur     String?
  slug        String
  color_code  String?
  sort_order  Int       @default(0)
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  version     Int       @default(1)
  device_id   String?

  items       Item[]

  @@index([tenant_id, branch_id])
}

model Item {
  id              String           @id @default(uuid())
  tenant_id       String
  branch_id       String
  category_id     String
  name_en         String
  name_ur         String?
  description     String?
  base_price      Decimal          @db.Decimal(10, 2)
  cost_price      Decimal          @default(0) @db.Decimal(10, 2)
  tax_rate        Decimal          @default(0.00) @db.Decimal(5, 2)
  photo_url       String?
  is_available    Boolean          @default(true)
  is_favourite    Boolean          @default(false)
  station_type    KdsStationType   @default(BAR)
  sort_order      Int              @default(0)
  dietary_tags    String[]
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  deleted_at      DateTime?
  version         Int              @default(1)
  device_id       String?

  category        Category         @relation(fields: [category_id], references: [id])
  variants        ItemVariant[]
  modifier_groups ItemModifierGroup[]
  recipes         Recipe[]
  order_items     OrderItem[]

  @@index([tenant_id, category_id])
}

model ItemVariant {
  id          String      @id @default(uuid())
  tenant_id   String
  branch_id   String
  item_id     String
  name        String
  price       Decimal     @db.Decimal(10, 2)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
  deleted_at  DateTime?
  version     Int         @default(1)
  device_id   String?

  item        Item        @relation(fields: [item_id], references: [id])
  recipes     Recipe[]
  order_items OrderItem[]
}

model ModifierGroup {
  id          String              @id @default(uuid())
  tenant_id   String
  branch_id   String
  name_en     String
  name_ur     String?
  is_required Boolean             @default(false)
  min_select  Int                 @default(0)
  max_select  Int                 @default(1)
  created_at  DateTime            @default(now())
  updated_at  DateTime            @updatedAt
  deleted_at  DateTime?
  version     Int                 @default(1)
  device_id   String?

  modifiers   Modifier[]
  item_groups ItemModifierGroup[]
}

model Modifier {
  id                String             @id @default(uuid())
  tenant_id         String
  branch_id         String
  modifier_group_id String
  name_en           String
  name_ur           String?
  price_add         Decimal            @default(0.00) @db.Decimal(10, 2)
  is_default        Boolean            @default(false)
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt
  deleted_at        DateTime?
  version           Int                @default(1)
  device_id         String?

  modifier_group    ModifierGroup      @relation(fields: [modifier_group_id], references: [id])
  order_modifiers   OrderItemModifier[]
}

model ItemModifierGroup {
  id                String        @id @default(uuid())
  tenant_id         String
  branch_id         String
  item_id           String
  modifier_group_id String
  sort_order        Int           @default(0)
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  deleted_at        DateTime?
  version           Int           @default(1)
  device_id         String?

  item              Item          @relation(fields: [item_id], references: [id])
  modifier_group    ModifierGroup @relation(fields: [modifier_group_id], references: [id])

  @@unique([item_id, modifier_group_id])
}

model Combo {
  id          String      @id @default(uuid())
  tenant_id   String
  branch_id   String
  name_en     String
  name_ur     String?
  price       Decimal     @db.Decimal(10, 2)
  photo_url   String?
  is_active   Boolean     @default(true)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
  deleted_at  DateTime?
  version     Int         @default(1)
  device_id   String?

  combo_items ComboItem[]
}

model ComboItem {
  id          String    @id @default(uuid())
  tenant_id   String
  branch_id   String
  combo_id    String
  item_id     String
  quantity    Int       @default(1)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  version     Int       @default(1)
  device_id   String?

  combo       Combo     @relation(fields: [combo_id], references: [id])
}

// --------------------------------------------------------
// MODULE 3: SALES, ORDERS & BILLING
// --------------------------------------------------------

model Order {
  id               String        @id @default(uuid())
  tenant_id        String
  branch_id        String
  order_number     String
  tax_invoice_no   String?
  order_type       OrderType     @default(DINE_IN)
  status           OrderStatus   @default(PENDING)
  table_id         String?
  cashier_id       String
  waiter_id        String?
  customer_id      String?
  subtotal         Decimal       @db.Decimal(10, 2)
  discount_amount  Decimal       @default(0.00) @db.Decimal(10, 2)
  discount_reason  String?
  tax_amount       Decimal       @default(0.00) @db.Decimal(10, 2)
  service_charge   Decimal       @default(0.00) @db.Decimal(10, 2)
  total_amount     Decimal       @db.Decimal(10, 2)
  notes            String?
  held_at          DateTime?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  deleted_at       DateTime?
  version          Int           @default(1)
  device_id        String?

  branch           Branch        @relation(fields: [branch_id], references: [id])
  table            Table?        @relation(fields: [table_id], references: [id])
  cashier          User          @relation("OrderCashier", fields: [cashier_id], references: [id])
  customer         Customer?     @relation(fields: [customer_id], references: [id])
  items            OrderItem[]
  payments         Payment[]
  refunds          Refund[]
  kds_tickets      KdsTicket[]
  feedback         Feedback?

  @@index([tenant_id, branch_id, status])
  @@index([order_number])
}

model OrderItem {
  id              String              @id @default(uuid())
  tenant_id       String
  branch_id       String
  order_id        String
  item_id         String
  variant_id      String?
  quantity        Int                 @default(1)
  unit_price      Decimal             @db.Decimal(10, 2)
  total_price     Decimal             @db.Decimal(10, 2)
  discount_amount Decimal             @default(0.00) @db.Decimal(10, 2)
  notes           String?
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt
  deleted_at      DateTime?
  version         Int                 @default(1)
  device_id       String?

  order           Order               @relation(fields: [order_id], references: [id])
  item            Item                @relation(fields: [item_id], references: [id])
  variant         ItemVariant?        @relation(fields: [variant_id], references: [id])
  modifiers       OrderItemModifier[]
  kds_items       KdsTicketItem[]

  @@index([order_id])
}

model OrderItemModifier {
  id            String    @id @default(uuid())
  tenant_id     String
  branch_id     String
  order_item_id String
  modifier_id   String
  unit_price    Decimal   @db.Decimal(10, 2)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  version       Int       @default(1)
  device_id     String?

  order_item    OrderItem @relation(fields: [order_item_id], references: [id])
  modifier      Modifier  @relation(fields: [modifier_id], references: [id])
}

model Payment {
  id             String        @id @default(uuid())
  tenant_id      String
  branch_id      String
  order_id       String
  payment_method PaymentMethod @default(CASH)
  amount         Decimal       @db.Decimal(10, 2)
  amount_tendered Decimal?     @db.Decimal(10, 2)
  change_returned Decimal?     @db.Decimal(10, 2)
  tip_amount     Decimal       @default(0.00) @db.Decimal(10, 2)
  reference_no   String?
  status         PaymentStatus @default(PAID)
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  deleted_at     DateTime?
  version        Int           @default(1)
  device_id      String?

  order          Order         @relation(fields: [order_id], references: [id])

  @@index([tenant_id, order_id])
}

model Refund {
  id              String    @id @default(uuid())
  tenant_id       String
  branch_id       String
  order_id        String
  amount          Decimal   @db.Decimal(10, 2)
  reason          String
  approved_by_pin String
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?
  version         Int       @default(1)
  device_id       String?

  order           Order     @relation(fields: [order_id], references: [id])
}

// --------------------------------------------------------
// MODULE 4: TABLES & FLOOR PLAN
// --------------------------------------------------------

model FloorArea {
  id         String    @id @default(uuid())
  tenant_id  String
  branch_id  String
  name       String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  version    Int       @default(1)
  device_id  String?

  branch     Branch    @relation(fields: [branch_id], references: [id])
  tables     Table[]
}

model Table {
  id            String      @id @default(uuid())
  tenant_id     String
  branch_id     String
  floor_area_id String
  table_number  String
  capacity      Int         @default(4)
  pos_x         Float       @default(0.0)
  pos_y         Float       @default(0.0)
  shape         String      @default("ROUND")
  is_occupied   Boolean     @default(false)
  current_waiter_id String?
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt
  deleted_at    DateTime?
  version       Int         @default(1)
  device_id     String?

  floor_area    FloorArea   @relation(fields: [floor_area_id], references: [id])
  branch        Branch      @relation(fields: [branch_id], references: [id])
  orders        Order[]
  reservations  Reservation[]
}

model Reservation {
  id          String    @id @default(uuid())
  tenant_id   String
  branch_id   String
  table_id    String
  guest_name  String
  guest_phone String
  party_size  Int
  start_time  DateTime
  notes       String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  version     Int       @default(1)
  device_id   String?

  table       Table     @relation(fields: [table_id], references: [id])
}

// --------------------------------------------------------
// MODULE 5: KITCHEN DISPLAY SYSTEM (KDS)
// --------------------------------------------------------

model KdsStation {
  id           String         @id @default(uuid())
  tenant_id    String
  branch_id    String
  name         String
  station_type KdsStationType @default(BAR)
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt
  deleted_at   DateTime?
  version      Int            @default(1)
  device_id    String?

  tickets      KdsTicket[]
}

model KdsTicket {
  id             String         @id @default(uuid())
  tenant_id      String
  branch_id      String
  kds_station_id String
  order_id       String
  order_number   String
  order_type     OrderType
  table_label    String?
  status         OrderStatus    @default(PENDING)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  deleted_at     DateTime?
  version        Int            @default(1)
  device_id      String?

  station        KdsStation     @relation(fields: [kds_station_id], references: [id])
  order          Order          @relation(fields: [order_id], references: [id])
  items          KdsTicketItem[]
  events         TicketEvent[]

  @@index([tenant_id, status])
}

model KdsTicketItem {
  id            String           @id @default(uuid())
  tenant_id     String
  branch_id     String
  kds_ticket_id String
  order_item_id String
  item_name     String
  variant_name  String?
  modifiers     String[]
  notes         String?
  status        TicketItemStatus @default(PENDING)
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt
  deleted_at    DateTime?
  version       Int              @default(1)
  device_id     String?

  ticket        KdsTicket        @relation(fields: [kds_ticket_id], references: [id])
  order_item    OrderItem        @relation(fields: [order_item_id], references: [id])
}

model TicketEvent {
  id            String    @id @default(uuid())
  tenant_id     String
  branch_id     String
  kds_ticket_id String
  event_type    String
  recorded_by   String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  version       Int       @default(1)
  device_id     String?

  ticket        KdsTicket @relation(fields: [kds_ticket_id], references: [id])
}

// --------------------------------------------------------
// MODULE 6: CASH DRAWER & SESSIONS
// --------------------------------------------------------

model CashSession {
  id             String               @id @default(uuid())
  tenant_id      String
  branch_id      String
  user_id        String
  opening_float  Decimal              @db.Decimal(10, 2)
  closing_float  Decimal?             @db.Decimal(10, 2)
  expected_cash  Decimal?             @db.Decimal(10, 2)
  variance       Decimal?             @db.Decimal(10, 2)
  status         String               @default("OPEN")
  notes          String?
  opened_at      DateTime             @default(now())
  closed_at      DateTime?
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt
  deleted_at     DateTime?
  version        Int                  @default(1)
  device_id      String?

  user           User                 @relation(fields: [user_id], references: [id])
  movements      CashMovement[]
  denominations  DenominationCount[]

  @@index([tenant_id, branch_id, status])
}

model CashMovement {
  id              String       @id @default(uuid())
  tenant_id       String
  branch_id       String
  cash_session_id String
  movement_type   String
  amount          Decimal      @db.Decimal(10, 2)
  reason          String
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  deleted_at      DateTime?
  version         Int          @default(1)
  device_id       String?

  session         CashSession  @relation(fields: [cash_session_id], references: [id])
}

model DenominationCount {
  id              String       @id @default(uuid())
  tenant_id       String
  branch_id       String
  cash_session_id String
  denomination    Int
  count           Int
  total_value     Decimal      @db.Decimal(10, 2)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  deleted_at      DateTime?
  version         Int          @default(1)
  device_id       String?

  session         CashSession  @relation(fields: [cash_session_id], references: [id])
}

// --------------------------------------------------------
// MODULE 7: INVENTORY & RECIPES
// --------------------------------------------------------

model Unit {
  id          String           @id @default(uuid())
  tenant_id   String
  branch_id   String
  name        String
  abbr        String
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt
  deleted_at  DateTime?
  version     Int              @default(1)
  device_id   String?

  stock_items StockItem[]
  conversions UnitConversion[] @relation("BaseUnit")
}

model UnitConversion {
  id            String    @id @default(uuid())
  tenant_id     String
  branch_id     String
  base_unit_id  String
  target_abbr   String
  multiplier    Decimal   @db.Decimal(12, 4)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  version       Int       @default(1)
  device_id     String?

  base_unit     Unit      @relation("BaseUnit", fields: [base_unit_id], references: [id])
}

model Location {
  id          String      @id @default(uuid())
  tenant_id   String
  branch_id   String
  name        String
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
  deleted_at  DateTime?
  version     Int         @default(1)
  device_id   String?

  branch      Branch      @relation(fields: [branch_id], references: [id])
  batches     StockBatch[]
}

model StockItem {
  id             String          @id @default(uuid())
  tenant_id      String
  branch_id      String
  name           String
  unit_id        String
  current_qty    Decimal         @default(0.000) @db.Decimal(12, 3)
  min_reorder_qty Decimal        @default(5.000) @db.Decimal(12, 3)
  avg_unit_cost  Decimal         @default(0.00) @db.Decimal(10, 2)
  is_prep_item   Boolean         @default(false)
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  deleted_at     DateTime?
  version        Int             @default(1)
  device_id      String?

  unit           Unit            @relation(fields: [unit_id], references: [id])
  recipes        RecipeLine[]
  batches        StockBatch[]
  movements      StockMovement[]
  vendor_items   VendorItem[]
  po_lines       PoLine[]
  gr_lines       GrLine[]
  wastage        Wastage[]

  @@index([tenant_id, branch_id])
}

model Recipe {
  id          String       @id @default(uuid())
  tenant_id   String
  branch_id   String
  item_id     String
  variant_id  String?
  name        String
  yield_qty   Int          @default(1)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  deleted_at  DateTime?
  version     Int          @default(1)
  device_id   String?

  item        Item         @relation(fields: [item_id], references: [id])
  variant     ItemVariant? @relation(fields: [variant_id], references: [id])
  lines       RecipeLine[]
}

model RecipeLine {
  id            String    @id @default(uuid())
  tenant_id     String
  branch_id     String
  recipe_id     String
  stock_item_id String
  quantity      Decimal   @db.Decimal(12, 4)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  version       Int       @default(1)
  device_id     String?

  recipe        Recipe    @relation(fields: [recipe_id], references: [id])
  stock_item    StockItem @relation(fields: [stock_item_id], references: [id])
}

model StockBatch {
  id            String    @id @default(uuid())
  tenant_id     String
  branch_id     String
  stock_item_id String
  location_id   String
  batch_number  String
  initial_qty   Decimal   @db.Decimal(12, 3)
  remaining_qty Decimal   @db.Decimal(12, 3)
  unit_cost     Decimal   @db.Decimal(10, 2)
  received_at   DateTime  @default(now())
  expires_at    DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  version       Int       @default(1)
  device_id     String?

  stock_item    StockItem @relation(fields: [stock_item_id], references: [id])
  location      Location  @relation(fields: [location_id], references: [id])

  @@index([stock_item_id, expires_at])
}

model StockMovement {
  id            String            @id @default(uuid())
  tenant_id     String
  branch_id     String
  stock_item_id String
  movement_type StockMovementType
  quantity      Decimal           @db.Decimal(12, 3)
  unit_cost     Decimal           @db.Decimal(10, 2)
  total_cost    Decimal           @db.Decimal(10, 2)
  reference_id  String?
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt
  deleted_at    DateTime?
  version       Int               @default(1)
  device_id     String?

  stock_item    StockItem         @relation(fields: [stock_item_id], references: [id])

  @@index([tenant_id, stock_item_id])
}

model Wastage {
  id            String    @id @default(uuid())
  tenant_id     String
  branch_id     String
  stock_item_id String
  quantity      Decimal   @db.Decimal(12, 3)
  cost_value    Decimal   @db.Decimal(10, 2)
  reason        String
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  version       Int       @default(1)
  device_id     String?

  stock_item    StockItem @relation(fields: [stock_item_id], references: [id])
}

model StockCount {
  id          String    @id @default(uuid())
  tenant_id   String
  branch_id   String
  counted_by  String
  status      String    @default("COMPLETED")
  variance    Decimal   @default(0.00) @db.Decimal(10, 2)
  notes       String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  version     Int       @default(1)
  device_id   String?
}

// --------------------------------------------------------
// MODULE 8: VENDORS & PURCHASING
// --------------------------------------------------------

model Vendor {
  id            String          @id @default(uuid())
  tenant_id     String
  branch_id     String
  name          String
  contact_person String?
  phone         String
  whatsapp      String?
  email         String?
  payment_terms String?
  rating        Int             @default(5)
  balance_due   Decimal         @default(0.00) @db.Decimal(10, 2)
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  deleted_at    DateTime?
  version       Int             @default(1)
  device_id     String?

  vendor_items  VendorItem[]
  pos           PurchaseOrder[]
  bills         VendorBill[]
}

model VendorItem {
  id            String    @id @default(uuid())
  tenant_id     String
  branch_id     String
  vendor_id     String
  stock_item_id String
  price         Decimal   @db.Decimal(10, 2)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?
  version       Int       @default(1)
  device_id     String?

  vendor        Vendor    @relation(fields: [vendor_id], references: [id])
  stock_item    StockItem @relation(fields: [stock_item_id], references: [id])
}

model PurchaseOrder {
  id             String              @id @default(uuid())
  tenant_id      String
  branch_id      String
  vendor_id      String
  po_number      String              @unique
  status         PurchaseOrderStatus @default(DRAFT)
  total_amount   Decimal             @db.Decimal(10, 2)
  expected_date  DateTime?
  created_at     DateTime            @default(now())
  updated_at     DateTime            @updatedAt
  deleted_at     DateTime?
  version        Int                 @default(1)
  device_id      String?

  vendor         Vendor              @relation(fields: [vendor_id], references: [id])
  lines          PoLine[]
  goods_receipts GoodsReceipt[]
  bills          VendorBill[]
}

model PoLine {
  id                String        @id @default(uuid())
  tenant_id         String
  branch_id         String
  purchase_order_id String
  stock_item_id     String
  quantity          Decimal       @db.Decimal(12, 3)
  unit_price        Decimal       @db.Decimal(10, 2)
  line_total        Decimal       @db.Decimal(10, 2)
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  deleted_at        DateTime?
  version           Int           @default(1)
  device_id         String?

  po                PurchaseOrder @relation(fields: [purchase_order_id], references: [id])
  stock_item        StockItem     @relation(fields: [stock_item_id], references: [id])
}

model GoodsReceipt {
  id                String        @id @default(uuid())
  tenant_id         String
  branch_id         String
  purchase_order_id String
  grn_number        String        @unique
  received_date     DateTime      @default(now())
  received_by       String
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  deleted_at        DateTime?
  version           Int           @default(1)
  device_id         String?

  po                PurchaseOrder @relation(fields: [purchase_order_id], references: [id])
  lines             GrLine[]
}

model GrLine {
  id               String       @id @default(uuid())
  tenant_id        String
  branch_id        String
  goods_receipt_id String
  stock_item_id    String
  qty_received     Decimal      @db.Decimal(12, 3)
  unit_price       Decimal      @db.Decimal(10, 2)
  batch_number     String?
  expiry_date      DateTime?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  deleted_at       DateTime?
  version          Int          @default(1)
  device_id        String?

  goods_receipt    GoodsReceipt @relation(fields: [goods_receipt_id], references: [id])
  stock_item       StockItem    @relation(fields: [stock_item_id], references: [id])
}

model VendorBill {
  id                String          @id @default(uuid())
  tenant_id         String
  branch_id         String
  vendor_id         String
  purchase_order_id String?
  bill_number       String
  amount            Decimal         @db.Decimal(10, 2)
  paid_amount       Decimal         @default(0.00) @db.Decimal(10, 2)
  due_date          DateTime
  is_paid           Boolean         @default(false)
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  deleted_at        DateTime?
  version           Int             @default(1)
  device_id         String?

  vendor            Vendor          @relation(fields: [vendor_id], references: [id])
  po                PurchaseOrder?  @relation(fields: [purchase_order_id], references: [id])
  payments          VendorPayment[]
}

model VendorPayment {
  id             String        @id @default(uuid())
  tenant_id      String
  branch_id      String
  vendor_bill_id String
  amount         Decimal       @db.Decimal(10, 2)
  payment_method PaymentMethod @default(BANK_TRANSFER)
  reference_no   String?
  paid_at        DateTime      @default(now())
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  deleted_at     DateTime?
  version        Int           @default(1)
  device_id      String?

  bill           VendorBill    @relation(fields: [vendor_bill_id], references: [id])
}

// --------------------------------------------------------
// MODULE 9: HR, TIME CLOCK & PAYROLL
// --------------------------------------------------------

model StaffProfile {
  id           String    @id @default(uuid())
  tenant_id    String
  branch_id    String
  user_id      String    @unique
  cnic         String
  phone        String
  photo_url    String?
  salary_type  String
  base_salary  Decimal   @db.Decimal(10, 2)
  hourly_rate  Decimal?  @db.Decimal(10, 2)
  joining_date DateTime  @default(now())
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?
  version      Int       @default(1)
  device_id    String?

  user         User      @relation(fields: [user_id], references: [id])
  payslips     Payslip[]
  advances     Advance[]
}

model Shift {
  id          String    @id @default(uuid())
  tenant_id   String
  branch_id   String
  user_id     String
  start_time  DateTime
  end_time    DateTime
  status      String    @default("SCHEDULED")
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  version     Int       @default(1)
  device_id   String?

  user        User      @relation(fields: [user_id], references: [id])
}

model AttendanceEvent {
  id          String    @id @default(uuid())
  tenant_id   String
  branch_id   String
  user_id     String
  clock_in    DateTime  @default(now())
  clock_out   DateTime?
  selfie_url  String?
  overtime_min Int      @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  version     Int       @default(1)
  device_id   String?

  user        User      @relation(fields: [user_id], references: [id])
}

model Advance {
  id               String       @id @default(uuid())
  tenant_id        String
  branch_id        String
  staff_profile_id String
  amount           Decimal      @db.Decimal(10, 2)
  reason           String
  is_deducted      Boolean      @default(false)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  deleted_at       DateTime?
  version          Int          @default(1)
  device_id        String?

  staff_profile    StaffProfile @relation(fields: [staff_profile_id], references: [id])
}

model PayrollRun {
  id           String    @id @default(uuid())
  tenant_id    String
  branch_id    String
  period_start DateTime
  period_end   DateTime
  total_payout Decimal   @db.Decimal(10, 2)
  is_posted    Boolean   @default(false)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?
  version      Int       @default(1)
  device_id    String?

  payslips     Payslip[]
}

model Payslip {
  id               String       @id @default(uuid())
  tenant_id        String
  branch_id        String
  payroll_run_id   String
  staff_profile_id String
  base_pay         Decimal      @db.Decimal(10, 2)
  overtime_pay     Decimal      @default(0.00) @db.Decimal(10, 2)
  advances_deducted Decimal     @default(0.00) @db.Decimal(10, 2)
  bonus            Decimal      @default(0.00) @db.Decimal(10, 2)
  tip_share        Decimal      @default(0.00) @db.Decimal(10, 2)
  net_salary       Decimal      @db.Decimal(10, 2)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  deleted_at       DateTime?
  version          Int          @default(1)
  device_id        String?

  payroll_run      PayrollRun   @relation(fields: [payroll_run_id], references: [id])
  staff_profile    StaffProfile @relation(fields: [staff_profile_id], references: [id])
}

// --------------------------------------------------------
// MODULE 10: ACCOUNTING & DOUBLE-ENTRY LEDGER
// --------------------------------------------------------

model Account {
  id           String        @id @default(uuid())
  tenant_id    String
  code         String
  name         String
  account_type AccountType
  is_active    Boolean       @default(true)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt
  deleted_at   DateTime?
  version      Int           @default(1)
  device_id    String?

  tenant       Tenant        @relation(fields: [tenant_id], references: [id])
  lines        JournalLine[]

  @@unique([tenant_id, code])
}

model JournalEntry {
  id           String        @id @default(uuid())
  tenant_id    String
  branch_id    String
  entry_date   DateTime      @default(now())
  reference_no String?
  description  String
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt
  deleted_at   DateTime?
  version      Int           @default(1)
  device_id    String?

  lines        JournalLine[]

  @@index([tenant_id, entry_date])
}

model JournalLine {
  id               String       @id @default(uuid())
  tenant_id        String
  branch_id        String
  journal_entry_id String
  account_id       String
  debit            Decimal      @default(0.00) @db.Decimal(12, 2)
  credit           Decimal      @default(0.00) @db.Decimal(12, 2)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  deleted_at       DateTime?
  version          Int          @default(1)
  device_id        String?

  journal_entry    JournalEntry @relation(fields: [journal_entry_id], references: [id])
  account          Account      @relation(fields: [account_id], references: [id])
}

model Expense {
  id          String    @id @default(uuid())
  tenant_id   String
  branch_id   String
  category    String
  amount      Decimal   @db.Decimal(10, 2)
  paid_by     String
  receipt_url String?
  notes       String?
  is_recurring Boolean  @default(false)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  version     Int       @default(1)
  device_id   String?
}

// --------------------------------------------------------
// MODULE 11: CUSTOMERS, LOYALTY & FEEDBACK
// --------------------------------------------------------

model Customer {
  id             String          @id @default(uuid())
  tenant_id      String
  branch_id      String
  phone          String
  name           String?
  email          String?
  birthday       DateTime?
  loyalty_points Int             @default(0)
  stamp_count    Int             @default(0)
  credit_balance Decimal         @default(0.00) @db.Decimal(10, 2)
  credit_limit   Decimal         @default(5000.00) @db.Decimal(10, 2)
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt
  deleted_at     DateTime?
  version        Int             @default(1)
  device_id      String?

  orders         Order[]
  loyalty_ledger LoyaltyLedger[]

  @@unique([tenant_id, phone])
}

model LoyaltyLedger {
  id          String    @id @default(uuid())
  tenant_id   String
  branch_id   String
  customer_id String
  points      Int
  reason      String
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  version     Int       @default(1)
  device_id   String?

  customer    Customer  @relation(fields: [customer_id], references: [id])
}

model GiftCard {
  id          String    @id @default(uuid())
  tenant_id   String
  branch_id   String
  code        String    @unique
  balance     Decimal   @db.Decimal(10, 2)
  is_active   Boolean   @default(true)
  expires_at  DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  version     Int       @default(1)
  device_id   String?
}

model PromoCode {
  id          String    @id @default(uuid())
  tenant_id   String
  branch_id   String
  code        String    @unique
  discount_pct Decimal? @db.Decimal(5, 2)
  discount_val Decimal? @db.Decimal(10, 2)
  is_active   Boolean   @default(true)
  expires_at  DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  version     Int       @default(1)
  device_id   String?
}

model Feedback {
  id          String    @id @default(uuid())
  tenant_id   String
  branch_id   String
  order_id    String    @unique
  rating      Int
  comment     String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  version     Int       @default(1)
  device_id   String?

  order       Order     @relation(fields: [order_id], references: [id])
}

// --------------------------------------------------------
// MODULE 12: SYSTEM, AUDIT & SYNC ENGINE
// --------------------------------------------------------

model SyncCursor {
  id          String    @id @default(uuid())
  tenant_id   String
  device_id   String
  last_cursor BigInt    @default(0)
  updated_at  DateTime  @updatedAt

  @@unique([tenant_id, device_id])
}
