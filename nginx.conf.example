# ==============================================================================
# Rewind POS - High-Performance, Ultra-Low Resource Nginx Reverse Proxy Config
# Location on VPS: /etc/nginx/sites-available/rewind-pos
# Enable with: sudo ln -s /etc/nginx/sites-available/rewind-pos /etc/nginx/sites-enabled/
# ==============================================================================

# Fast upstream connection pool
upstream rewind_upstream {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    server_name your-domain.com; # Replace with your domain or VPS IP

    # Enable Gzip Compression for maximum speed and lowest bandwidth
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/xml
        application/json
        application/javascript
        application/rss+xml
        application/atom+xml
        image/svg+xml;

    # Client body limit
    client_max_body_size 16M;

    # 1. Ultra-fast direct static caching for Next.js JS/CSS chunks
    # Bypasses Node.js completely - served straight from disk cache in ~2ms!
    location /_next/static/ {
        alias /var/www/rewind-pos/.next/static/; # Update with your app path if different
        expires 365d;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # 2. Public static assets (images, icons, manifest, sounds)
    location /public/ {
        alias /var/www/rewind-pos/public/;
        expires 30d;
        access_log off;
        add_header Cache-Control "public, max-age=2592000";
    }

    # 3. Main Next.js Dynamic Reverse Proxy
    location / {
        proxy_pass http://rewind_upstream;
        proxy_http_version 1.1;

        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Standard headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeouts & buffering
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_buffering on;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }
}
